          "applicable_policy": "POL_CEIL_005",
          "expected_guard_action": "LIMIT",
          "permitted_help_ceiling": 4,
          "rationale": "Active assignment subject to Help Ceiling 4; complete solution walkthrough withheld."
        },
        {
          "variant_id": "CF_002_B",
          "context": {
            "authenticated_role": "Student",
            "resource_type": "assignment",
            "resource_relationship": "own",
            "resource_state": "released",
            "course_policy_profile": "BALANCED"
          },
          "applicable_policy": "POL_FEED_010",
          "expected_guard_action": "ALLOW",
          "permitted_help_ceiling": 6,
          "rationale": "Post-deadline released assignment permits full diagnostic review and retrospective solution walkthrough."
        }
      ]
    },
    {
      "family_id": "CF_FAM_003_RESOURCE_OWNERSHIP",
